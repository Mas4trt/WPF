<Window x:Class="AngryBirds.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AngryBirds"
        mc:Ignorable="d"
        Icon="/Resources/icon.ico"
        Title="AngryBirdsY"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True">
    <Window.Resources>
        <DropShadowEffect x:Key="GlowEffect" Color="Yellow" BlurRadius="20" ShadowDepth="0"/>
    </Window.Resources>
    <Viewbox Stretch="Fill">
        <Grid x:Name="MainGrid" Width="1920" Height="1080">
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Resources/background.jpg" Stretch="Fill"/>
            </Grid.Background>
            <ContentControl x:Name="MainContent" />

            <!-- Кнопки "Играть" и "Выход" -->
            <StackPanel x:Name="ButtonsPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="584"
                        Panel.ZIndex="5" Height="350">
                <Button x:Name="Play"
                        Width="560"
                        Height="170"
                        Click="PlayButton_Click"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="HoverEffect"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        CornerRadius="10"/>
                                <Image x:Name="PLayButtonMenu" Source="/Resources/Play.png" Stretch="Fill"/>
                                <TextBlock x:Name="PlayText"
                                        Text="Play"
                                       Foreground="White"
                                       FontSize="56"
                                       FontWeight="Bold" Margin="218,38,218,58"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PLayButtonMenu" Property="Effect" Value="{StaticResource GlowEffect}"/>
                                    <Setter TargetName="PlayText"  Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="Exit"
                        Width="560"
                        Height="170"         
                        Click="ExitButton_Click"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
        >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="HoverEffect"
                                Background="Transparent"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                CornerRadius="10"/>
                                <Image x:Name="ExitButtonMenu" Source="/Resources/Play.png" Stretch="Fill"/>
                                <TextBlock x:Name="ExitText"
                                    Text="Exit"
                                    Foreground="White"
                                    FontSize="56"
                                    FontWeight="Bold" Margin="228,38,228,58"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ExitButtonMenu" Property="Effect" Value="{StaticResource GlowEffect}"/>
                                    <Setter TargetName="ExitText"  Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Кнопка "Настройки" с иконкой -->
            <Button x:Name="Settings"
                    Width="94"
                    Height="93"
                    Click="Settings_Click"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="38,31,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverEffect"
                                    Background="Transparent"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    CornerRadius="10"/>
                            <Image x:Name="SettingButton" Source="/Resources/Settings.png" Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SettingButton" Property="Effect" Value="{StaticResource GlowEffect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <local:SettingsMenu x:Name="SettingsMenuControl" Visibility="Collapsed" Panel.ZIndex="10"/>

            <!-- Панель настроек -->
        </Grid>
    </Viewbox>
</Window>



