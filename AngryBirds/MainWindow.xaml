<Window x:Class="AngryBirds.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AngryBirds"
        mc:Ignorable="d"
        Icon="/Resources/icon.ico"
        Title="AngryBirdsY"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True">
    <Viewbox Stretch="Fill">
        <Grid x:Name="MainGrid" Width="1920" Height="1080">
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Resources/background.jpg" Stretch="Fill"/>
            </Grid.Background>

            <!-- Кнопки "Играть" и "Выход" -->
            <StackPanel x:Name="ButtonsPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="660"
                        Panel.ZIndex="5" Height="194">
                <Button Content="Play"
                        Width="344"
                        Height="86"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,0,20"
                        Click="PlayButton_Click"
                        Style="{StaticResource YellowCloseButtonStyle}"/>
                <Button Content="Выйти"
                        Width="340"
                        Height="85"
                        FontSize="24"
                        FontWeight="Bold"
                        Click="ExitButton_Click"
                        Style="{StaticResource YellowCloseButtonStyle}"/>
            </StackPanel>

            <!-- Кнопка "Настройки" с иконкой -->
            <Button x:Name="Settings"
                    Width="80"
                    Height="79"
                    Click="Settings_Click"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="38,31,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverEffect"
                                    Background="Transparent"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    CornerRadius="10"/>
                            <Image Source="/Resources/Settings.png" Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverEffect" Property="Background" Value="#33CCCCCC"/>
                                <Setter TargetName="HoverEffect" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <local:SettingsMenu x:Name="SettingsMenuControl" Visibility="Collapsed" Panel.ZIndex="10"/>

            <!-- Панель настроек -->
        </Grid>
    </Viewbox>
</Window>



